# M6 — MIR events; control flow is a clone of parser.bq (M4 PASS)
use std.fs.read
use std.io.println
use std.text.byte
use std.text.eq
use std.text.len
use std.text.slice

fn g_is_ws(c: int) -> bool {
    c == 32 || c == 9 || c == 10 || c == 13
}

fn g_is_ident_start(c: int) -> bool {
    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn g_is_ident_cont(c: int) -> bool {
    g_is_ident_start(c) || (c >= 48 && c <= 57)
}

fn g_is_digit(c: int) -> bool {
    c >= 48 && c <= 57
}

fn g_skip(src: text, idx: int, n: int) -> int {
    i = idx
    while i < n {
        c = byte(src, i)
        if g_is_ws(c) {
            i = i + 1
        } elif c == 35 {
            while i < n {
                if byte(src, i) == 10 {
                    i = i + 1
                    break
                }
                i = i + 1
            }
        } else {
            break
        }
    }
    i
}

fn g_ident_end(src: text, start: int, n: int) -> int {
    i = start
    while i < n {
        if g_is_ident_cont(byte(src, i)) {
            i = i + 1
        } else {
            break
        }
    }
    i
}

fn g_word_is(src: text, idx: int, n: int, w: text) -> bool {
    k = len(w)
    if idx + k > n {
        return false
    }
    if eq(slice(src, idx, idx + k), w) {
        if g_is_ident_cont(byte(src, idx + k)) {
            return false
        }
        return true
    }
    false
}

fn g_skip_type(src: text, idx: int, n: int) -> int {
    i = g_skip(src, idx, n)
    g_ident_end(src, i, n)
}

fn g_prefix(src: text, idx: int, n: int) -> int {
    i = g_skip(src, idx, n)
    c = byte(src, i)
    if g_is_digit(c) {
        e = i
        while e < n {
            if g_is_digit(byte(src, e)) {
                e = e + 1
            } else {
                break
            }
        }
        println("const")
        println(slice(src, i, e))
        return e
    }
    if g_is_ident_start(c) {
        e = g_ident_end(src, i, n)
        name = slice(src, i, e)
        i = g_skip(src, e, n)
        if byte(src, i) == 40 {
            println("call")
            println(name)
            return g_args(src, i, n)
        }
        println(name)
        return e
    }
    i
}

fn g_args(src: text, idx: int, n: int) -> int {
    i = g_skip(src, idx, n)
    if byte(src, i) == 40 {
        i = i + 1
    }
    i = g_skip(src, i, n)
    if byte(src, i) == 41 {
        return i + 1
    }
    i = g_expr(src, i, n)
    i = g_skip(src, i, n)
    while byte(src, i) == 44 {
        i = g_expr(src, i + 1, n)
        i = g_skip(src, i, n)
    }
    if byte(src, i) == 41 {
        i = i + 1
    }
    i
}

fn g_expr(src: text, idx: int, n: int) -> int {
    i = g_prefix(src, idx, n)
    i = g_skip(src, i, n)
    c = byte(src, i)
    nxt = byte(src, i + 1)
    if c == 43 {
        println("add")
        return g_prefix(src, i + 1, n)
    }
    if c == 45 {
        if nxt != 62 {
            println("sub")
            return g_prefix(src, i + 1, n)
        }
    }
    if c == 62 {
        if nxt == 61 {
            println("sge")
            return g_prefix(src, i + 2, n)
        }
        println("sgt")
        return g_prefix(src, i + 1, n)
    }
    i
}

fn g_block(src: text, idx: int, n: int) -> int {
    i = g_skip(src, idx, n)
    if byte(src, i) == 123 {
        i = i + 1
    }
    i = g_skip(src, i, n)
    while i < n {
        if byte(src, i) == 125 {
            return i + 1
        }
        if g_word_is(src, i, n, "if") {
            i = g_if(src, i, n)
        } elif g_word_is(src, i, n, "return") {
            i = g_skip(src, i + 6, n)
            println("ret")
            i = g_expr(src, i, n)
        } else {
            i = g_expr(src, i, n)
        }
        i = g_skip(src, i, n)
    }
    i
}

fn g_if(src: text, idx: int, n: int) -> int {
    i = g_skip(src, idx + 2, n)
    println("icmp")
    i = g_expr(src, i, n)
    g_block(src, i, n)
}

fn g_params(src: text, idx: int, n: int) -> int {
    i = g_skip(src, idx, n)
    if byte(src, i) == 40 {
        i = i + 1
    }
    i = g_skip(src, i, n)
    if byte(src, i) == 41 {
        return i + 1
    }
    while i < n {
        i = g_skip(src, i, n)
        e = g_ident_end(src, i, n)
        println("param")
        println(slice(src, i, e))
        i = g_skip(src, e, n)
        if byte(src, i) == 58 {
            i = g_skip(src, i + 1, n)
            i = g_skip_type(src, i, n)
        }
        i = g_skip(src, i, n)
        if byte(src, i) == 44 {
            i = i + 1
        } elif byte(src, i) == 41 {
            return i + 1
        } else {
            break
        }
    }
    i
}

fn g_fn(src: text, idx: int, n: int) -> int {
    i = g_skip(src, idx + 2, n)
    e = g_ident_end(src, i, n)
    println("fn")
    println(slice(src, i, e))
    i = g_params(src, e, n)
    i = g_skip(src, i, n)
    if byte(src, i) == 45 {
        if byte(src, i + 1) == 62 {
            i = g_skip(src, i + 2, n)
            i = g_skip_type(src, i, n)
        }
    }
    i = g_block(src, i, n)
    println("ret")
    i
}

pub fn dump_mir(path: text) {
    src = read(path)
    n = len(src)
    i = g_skip(src, 0, n)
    while i < n {
        if g_word_is(src, i, n, "fn") {
            i = g_fn(src, i, n)
        } elif g_word_is(src, i, n, "use") {
            while i < n {
                if byte(src, i) == 10 {
                    i = i + 1
                    break
                }
                i = i + 1
            }
        } else {
            i = i + 1
        }
        i = g_skip(src, i, n)
    }
}
