{
  "Main": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "\t$0",
      "}"
    ],
    "description": "main entry point"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "function"
  },
  "Module": {
    "prefix": "mod",
    "body": [
      "module ${1:name}",
      "",
      "$0"
    ],
    "description": "module declaration"
  },
  "Use": {
    "prefix": "use",
    "body": "use ${1:std.io}.{${2:println}}",
    "description": "import"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:cond} {",
      "\t$0",
      "}"
    ]
  },
  "For": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..=${3:n} {",
      "\t$0",
      "}"
    ]
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:int}",
      "}"
    ]
  },
  "Test": {
    "prefix": "test",
    "body": [
      "test ${1:name} {",
      "\texpect ${2:true}",
      "}"
    ]
  },
  "Lumen": {
    "prefix": "lumen",
    "body": [
      "use std.lumen.{app, heading, note, field, button, show}",
      "",
      "fn main() {",
      "\tapp(\"${1:App}\", ${2:1100}, ${3:720})",
      "\theading(\"${4:Title}\")",
      "\tshow()",
      "}"
    ],
    "description": "Lumen native window"
  },
  "Flowdesk": {
    "prefix": "flowdesk",
    "body": [
      "use std.flowdesk.{desk, show}",
      "",
      "fn main() {",
      "\tdesk(\"${1:Flowdesk}\", 1100, 720)",
      "\tshow()",
      "}"
    ],
    "description": "Flowdesk borderless app"
  },
  "Keel": {
    "prefix": "keel",
    "body": [
      "use std.keel.{page, api, run}",
      "",
      "fn main() {",
      "\tpage(\"/\", \"public/index.html\")",
      "\tapi(\"${1:items}\", \"${2:title, body}\")",
      "\trun()",
      "}"
    ],
    "description": "Keel HTTP API"
  }
}
