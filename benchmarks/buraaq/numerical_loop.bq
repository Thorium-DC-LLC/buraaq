extern c {
    fn buraaq_now_sec() -> f64
    fn buraaq_keepalive_i32(v: c.int) -> c.int
    fn buraaq_bench_report_f64(name: c.text, sec: f64, n: c.int, checksum: f64) -> void
}

fn main() {
    n = buraaq_keepalive_i32(100000000)
    mut sum = 0.0
    t0 = buraaq_now_sec()
    for i in 1..=n {
        sum = sum + 1.0 / i
    }
    t1 = buraaq_now_sec()
    elapsed = t1 - t0
    buraaq_bench_report_f64("numerical_loop", elapsed, n, sum)
}
