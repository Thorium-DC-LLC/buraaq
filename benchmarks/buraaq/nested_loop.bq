extern c {
    fn buraaq_now_sec() -> f64
    fn buraaq_keepalive_i32(v: c.int) -> c.int
    fn buraaq_bench_report(name: c.text, sec: f64, n: c.int, checksum: c.int) -> void
}

fn main() {
    n = buraaq_keepalive_i32(10000)
    mut sum = 0
    mut i = 0
    t0 = buraaq_now_sec()
    while i < n {
        mut j = 0
        while j < n {
            sum = sum * 3 + 1
            j = j + 1
        }
        i = i + 1
    }
    t1 = buraaq_now_sec()
    elapsed = t1 - t0
    ops = n * n
    buraaq_bench_report("nested_loop", elapsed, ops, sum)
}
