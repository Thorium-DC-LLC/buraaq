module mathx

enum Lane {
    Ready,
    Fail,
}

fn lane_name(s: Lane) -> text {
    match s {
        .Ready => "ready",
        .Fail => "fail",
    }
}

fn max2[T](a: T, b: T) -> T {
    if a > b {
        a
    } else {
        b
    }
}

pub fn prove_math() {
    nums = [1, 2, 3]
    println(nums[2])
    println(max2(3, 9))
    mut s = 0
    for i in 1..=4 {
        s = s + i
    }
    println(s)
    println(lane_name(Lane.Ready))
}
